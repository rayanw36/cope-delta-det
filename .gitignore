# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.egg

# Virtual environments
venv/
.venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Dataset files (large, download separately — exclude entire data dirs)
data/bdd100k/
data/imagenetvid/

# Extracted features and encoded video (top-level legacy paths)
features/
hevc/

# Model checkpoints (large binary files)
checkpoints/*.pt
checkpoints/*.pth
runs/

# YOLO weights
*.pt
!requirements.txt

# Results — keep final JSON summaries, ignore logs and large files
results/*.log
results/eval_*.json
results/smoke_test.json

# Video outputs
*.avi
*.mp4

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log

# Claude Code session data
.claude/

# Debug artifacts
yolo_input_debug.jpg
eval_manual.py

# Report — track .txt reports, ignore drafts/markdown planning docs
report/*.md
report/*_todo.md

# GOP index files (regenerated by prepare scripts — covered by data/ rules above)
data/bdd100k/gop_index_*.json
